# Azure OpenAI / Azure AI Foundry
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure OpenAI deployment names
AZURE_OPENAI_DEPLOYMENT=your_default_deployment
AZURE_OPENAI_DEPLOYMENT_GPT_41=your_gpt_41_deployment
AZURE_OPENAI_DEPLOYMENT_GPT_54_mini=your_gpt_54_mini_deployment
AZURE_OPENAI_DEPLOYMENT_GPT_55=your_gpt_55_deployment
AZURE_OPENAI_DEPLOYMENT_GPT_4O_mini=your_gpt_4o_mini_deployment

# Azure AI Foundry Anthropic deployment (optional; used by digital_twin)
AZURE_CLAUDE_API_KEY=your_azure_ai_foundry_api_key
AZURE_CLAUDE_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/anthropic
AZURE_CLAUDE_DEPLOYMENT_OPUS_48=your_claude_deployment

# Optional web search providers (used by LangChain/LangGraph examples)
TAVILY_API_KEY=your_tavily_api_key
SERP_API_KEY=your_serper_api_key

# Optional local Outlook integration (comma-separated values are supported)
EMAIL_ADDRESS_TO=you@example.com

# Optional local paths for Google ADK/A2A examples
BOARD_PATH=
MCP_ROOT=

# Agent loop (5_agent_frameworks/5_agent_loop): orchestrator deployment, required
AZURE_OPENAI_DEPLOYMENT_GPT_56_SOL=your_orchestrator_deployment

# Agent loop, optional overrides
# Deployment the four workers use (defaults to AZURE_OPENAI_DEPLOYMENT_GPT_55)
WORKER_MODEL=
# api-version for the Google ADK/LiteLLM model; Azure's Responses API needs 2025-03-01-preview or newer
AZURE_OPENAI_ADK_API_VERSION=2025-04-01-preview
# Where filesystem_server.py listens (streamable HTTP)
FILESYSTEM_MCP_URL=http://127.0.0.1:8000/mcp
# 1 hides the QA browser window
QA_HEADLESS=
# Seconds before a worker / a QA check is stopped
WORKER_TIMEOUT_S=300
QA_TIMEOUT_S=150

# Google ADK / LiteLLM examples read these names for Azure (5_agent_frameworks/1_google_adk_a2a)
AZURE_API_KEY=your_azure_openai_api_key
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-12-01-preview