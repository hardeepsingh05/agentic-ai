# Azure OpenAI / Azure AI Foundry
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure OpenAI deployment names
AZURE_OPENAI_DEPLOYMENT=your_default_deployment
AZURE_OPENAI_DEPLOYMENT_GPT_41=your_gpt_41_deployment
AZURE_OPENAI_DEPLOYMENT_GPT_54_mini=your_gpt_54_mini_deployment
AZURE_OPENAI_DEPLOYMENT_GPT_55=your_gpt_55_deployment
AZURE_OPENAI_DEPLOYMENT_GPT_4O_mini=your_gpt_4o_mini_deployment

# Azure AI Foundry Anthropic deployment (optional; used by digital_twin)
AZURE_CLAUDE_API_KEY=your_azure_ai_foundry_api_key
AZURE_CLAUDE_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/anthropic
AZURE_CLAUDE_DEPLOYMENT_OPUS_48=your_claude_deployment

# Optional web search providers (used by LangChain/LangGraph examples)
TAVILY_API_KEY=your_tavily_api_key
SERP_API_KEY=your_serper_api_key

# Optional local Outlook integration (comma-separated values are supported)
EMAIL_ADDRESS_TO=you@example.com

# Optional local paths for Google ADK/A2A examples
BOARD_PATH=
MCP_ROOT=