# Git ignore file for the Agentic Frameworks project
# Ignore Python cache files
__pycache__/
*.py[cod]

# Ignore virtual environment directories
.venv312/
.venv/

# Ignore local environment files and credentials, but retain the safe template
.env
.env.*
!.env.example

# Ignore IDE specific files
.vscode/
.idea/
# Ignore log files
*.log

# Ignore SQLite database files
*.sqlite
*.sqlite-*
*.db

# Ignore Jupyter checkpoints and local browser automation artifacts
.ipynb_checkpoints/
.playwright-mcp/

# ignore some personal files
email.txt
Profile.pdf
summary.txt
user_message.txt